# Server
PORT=4000
NODE_ENV=development

# JWT Configuration (HS256)
JWT_SECRET=super_secret_jwt_key_restaurant_auth_2026!
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database Configuration (PostgreSQL)
# You can use DATABASE_URL or individual parameters:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fmat_auth
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fmat_auth

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://localhost:5672

# Seguridad
# Orígenes extra permitidos por CORS (separados por coma). localhost/127.0.0.1
# en cualquier puerto ya están permitidos para el desarrollo local.
# CORS_ORIGINS=https://restaurante.fmat.mx
# Intentos permitidos por minuto e IP en login / recuperación de contraseña
AUTH_RATE_LIMIT=10
