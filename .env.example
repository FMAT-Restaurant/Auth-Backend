# Server
PORT=4000
NODE_ENV=development

# JWT Configuration (HS256)
JWT_SECRET=super_secret_jwt_key_restaurant_auth_2026!
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database Configuration (PostgreSQL)
# You can use DATABASE_URL or individual parameters:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fmat_auth
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fmat_auth

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://localhost:5672
