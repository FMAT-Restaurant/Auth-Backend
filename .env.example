# Server
PORT=4000
NODE_ENV=development

# JWT Configuration (HS256)
# Obligatorio, mínimo 32 caracteres y el mismo valor que usa el API Gateway.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Database Configuration (PostgreSQL)
# You can use DATABASE_URL or individual parameters:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fmat_auth
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fmat_auth

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://localhost:5672

# Seguridad
# Orígenes permitidos por CORS (separados por coma). Fuera de producción,
# localhost/127.0.0.1 en cualquier puerto ya están permitidos; con
# NODE_ENV=production solo valen los de esta lista.
# CORS_ORIGINS=https://restaurante.fmat.mx
# Intentos permitidos por minuto e IP en login / recuperación de contraseña
AUTH_RATE_LIMIT=10
# Intentos permitidos por cuenta (correo o Staff ID) en la ventana indicada;
# al superarlos, la cuenta queda bloqueada esa misma cantidad de minutos.
AUTH_IDENTIFIER_RATE_LIMIT=10
AUTH_IDENTIFIER_WINDOW_MINUTES=15
# Días que dura un refresh token sin usarse (1 a 30; por defecto 7).
REFRESH_TOKEN_TTL_DAYS=7
# Proxies de confianza para leer X-Forwarded-For. Vacío = solo el proxy privado
# inmediato (API Gateway / nginx). Valores: false, número de saltos o lista de IPs.
# TRUST_PROXY=
